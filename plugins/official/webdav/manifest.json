{
  "schemaVersion": 1,
  "id": "org.fiex.webdav",
  "name": "WebDAV",
  "version": "0.1.0",
  "protocolVersion": "1.0",
  "capabilities": [
    "filesystem",
    "connectionFactory"
  ],
  "entrypoints": {
    "windows-x86_64": "fiex-plugin-webdav.exe",
    "macos-aarch64": "fiex-plugin-webdav",
    "macos-x86_64": "fiex-plugin-webdav",
    "linux-x86_64": "fiex-plugin-webdav"
  },
  "contributes": {
    "connectionFactories": [
      {
        "id": "webdav",
        "title": "WebDAV",
        "fields": [
          {
            "id": "url",
            "label": "服务器地址",
            "type": "url",
            "required": true,
            "placeholder": "https://example.com/dav"
          },
          {
            "id": "username",
            "label": "用户名",
            "type": "text"
          },
          {
            "id": "password",
            "label": "密码",
            "type": "secret"
          },
          {
            "id": "allowInvalidCerts",
            "label": "允许自签名证书",
            "type": "checkbox"
          }
        ]
      }
    ],
    "settings": [
      {
        "id": "timeout",
        "label": "连接超时（秒）",
        "type": "number",
        "defaultValue": "90"
      },
      {
        "id": "cacheMetadataTtl",
        "label": "目录刷新周期（秒）",
        "type": "number",
        "defaultValue": "60"
      }
    ]
  },
  "permissions": {
    "storage": true,
    "secrets": true,
    "network": true,
    "filesystem.read": true,
    "filesystem.write": true,
    "externalCommands": false,
    "ui.dialog": true
  },
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/flex-official-plugins"
  }
}
